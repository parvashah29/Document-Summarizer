# Google Gemini API key (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Preferred model; if unavailable the app falls back to
# gemini-3-flash-preview -> gemini-3.1-flash-lite -> gemini-2.5-flash
GEMINI_MODEL=gemini-3.1-flash-lite

# Flask session signing key. Generate one: python -c "import secrets; print(secrets.token_hex(32))"
# (an insecure development default is used if unset - always set it in production)
SECRET_KEY=

# Optional
# PORT=5001
# HOST=127.0.0.1
# FLASK_DEBUG=0
# MAX_UPLOAD_MB=16
# DATABASE_URL=sqlite:///docsum.db
# UPLOAD_FOLDER=/absolute/path/to/uploads
# LLM_RETRIES=3             # retries per model on 429/5xx
# LLM_BACKOFF_SECONDS=2     # base delay, doubled each retry
